# Database (Neon o Supabase)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Payload CMS
PAYLOAD_SECRET=cambia-questa-stringa-con-qualcosa-di-lungo-e-casuale

# NextAuth
NEXTAUTH_SECRET=cambia-anche-questa-stringa
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# URL pubblico del sito (in produzione)
NEXT_PUBLIC_SITE_URL=https://08naturaltechnology.it

# Email transazionali via Brevo (newsletter, ordini, account, reset password)
# Il destinatario delle notifiche admin (nuovo ordine, form contatti) è COMPANY_EMAIL,
# impostabile da /admin/impostazioni — non da variabile d'ambiente.
EMAIL_FROM="08 Natural Technology <mittente-verificato@dominio.it>"
EMAIL_REPLY_TO=08naturaltechnology@gmail.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=login-smtp-fornito-da-brevo
SMTP_PASS=chiave-smtp-generata-su-brevo
SMTP_TIMEOUT_MS=20000

# Live chat intelligente
# Nessuna chiave API necessaria: la chat usa i contenuti del sito e risposte guidate lato server.

# Poste Italiane - Delivery Point API (locker)
# In produzione sostituire con gli endpoint apiw.gp.posteitaliane.it/gs/internet/...
POSTE_CLIENT_ID=
POSTE_CLIENT_SECRET=
POSTE_SCOPE=api://8f0f2c58-19a8-45ef-9f9e-8bcb0acc7657/.default
POSTE_AUTH_URL=https://apid.gp.posteitaliane.it/dev/kindergarden/user/sessions
POSTE_DELIVERY_POINT_URL=https://apid.gp.posteitaliane.it/dev/kindergarden/postalandlogistics/parcel/deliveryPoint

# BRT — Pudo-Fermopoint API (ricerca punti di ritiro)
BRT_API_HOST=https://api.brt.it
BRT_API_TOKEN=
