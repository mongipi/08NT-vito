generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Line {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  color      String
  colorLight String
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  lineId           String
  line             Line        @relation(fields: [lineId], references: [id])
  price            Float
  comparePrice     Float?
  stock            Int         @default(0)
  published        Boolean     @default(false)
  order            Int         @default(99)
  shortDescription String
  longDescription  String
  usage            String?
  target           String?
  format           String?
  capsules         Int?
  days             Int?
  dosage           String?
  notificationMs   String?
  ingredients      Json        @default("[]")
  images           Json        @default("{}")
  metaTitle        String?
  metaDescription  String?
  b2bPricing       B2BPricing?
  productImages    ProductImage[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  body            String   @db.Text
  tag             String
  publishedAt     DateTime
  readingTime     Int?
  published       Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  consumer
  b2b
  admin
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  password         String?
  role             Role      @default(consumer)
  company          String?
  vatNumber        String?
  stripeCustomerId String?
  accounts         Account[]
  orders           Order[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  items                 Json
  subtotal              Float
  discountAmount        Float       @default(0)
  total                 Float
  couponCode            String?
  status                OrderStatus @default(pending)
  stripePaymentIntentId String?
  shippingAddress       Json
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

enum DiscountType {
  percent
  fixed
}

enum ApplicableTo {
  all
  b2b
  consumer
}

model Discount {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Float
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  applicableTo   ApplicableTo @default(all)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model B2BPricing {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])
  price     Float
  minQty    Int     @default(1)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  key       String
  mimeType  String  @default("image/png")
  data      Bytes
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  alt       String
  url       String
  width     Int?
  height    Int?
  mimeType  String?
  createdAt DateTime @default(now())
}
